// 병합 정렬 — 수업 자료(algorithm-code의 mergeSort.pseudo)와 같은 절차다.
// mergeSort.c가 이것을 원소 타입과 무관하게 옮긴 것이다.

ALGORITHM MergeSort(A, lo, hi)
    INPUT   A: 배열, lo..hi: 정렬할 범위
    OUTPUT  오름차순으로 정렬된 A[lo..hi]

    if lo >= hi then return          // 원소 하나면 이미 정렬
    mid <- (lo + hi) / 2
    MergeSort(A, lo, mid)            // 왼쪽 절반
    MergeSort(A, mid+1, hi)          // 오른쪽 절반
    Merge(A, lo, mid, hi)            // 정렬된 두 절반을 합친다

ALGORITHM Merge(A, lo, mid, hi)
    // A[lo..mid]와 A[mid+1..hi]는 각각 정렬되어 있다
    i <- lo, j <- mid+1, k <- lo
    while i <= mid and j <= hi do
        if A[i] <= A[j] then         // 비교 1회. <=라서 안정적이다
            T[k] <- A[i]; i++        // 이동 1회
        else
            T[k] <- A[j]; j++        // 이동 1회
        k++
    남은 원소를 T로 복사             // 원소마다 이동 1회
    T[lo..hi]를 A[lo..hi]로 복사     // 원소마다 이동 1회

// 비교 횟수: 병합마다 최대 (구간 길이 - 1). 전체 O(n log n)
// 이동 횟수: 병합마다 구간 길이의 2배 (T로 갔다가 돌아온다)
// 공간: 임시 배열 T가 필요하다. O(n)
