// 힙 정렬 — 이 과제의 "배우지 않은 정렬". heapSort.c가 이것을 옮긴 것이다.
//
// 배열을 완전 이진 트리로 읽는다 (0부터 센다).
//   A[i]의 왼쪽 자식 A[2i+1], 오른쪽 자식 A[2i+2], 부모 A[(i-1)/2]
// 최대 힙: 모든 노드가 자기 자식들보다 크거나 같다. 그래서 A[0]이 최댓값이다.

ALGORITHM HeapSort(A, n)
    // 1단계: 힙 만들기. 잎이 아닌 마지막 노드부터 거꾸로 내려보낸다
    for i <- n/2 - 1 downto 0 do
        SiftDown(A, i, n)
    // 2단계: 최댓값(루트)을 끝으로 보내고, 하나 줄어든 힙의 루트를 고친다
    for end <- n-1 downto 1 do
        swap A[0], A[end]            // 이동 3회. A[end]는 자리가 확정된다
        SiftDown(A, 0, end)          // A[0..end-1]만 힙으로 본다

ALGORITHM SiftDown(A, i, n)
    loop
        largest <- i
        l <- 2i + 1, r <- 2i + 2
        if l < n and A[l] > A[largest] then largest <- l     // 비교 1회
        if r < n and A[r] > A[largest] then largest <- r     // 비교 1회
        if largest = i then return   // 두 자식보다 크거나 같다
        swap A[i], A[largest]        // 이동 3회
        i <- largest                 // 한 층 내려간다

// 비교 횟수: SiftDown 한 번이 많아야 트리 높이 log n 층, 층마다 2회.
//   2단계가 n-1번이므로 전체 O(n log n). 최선 · 평균 · 최악이 같다.
// 1단계는 O(n)이다. 높이 h인 노드는 많아야 h층 내려가는데, 높이의 합이 n보다
//   작기 때문이다. 비교는 2n회를 넘지 않는다 (실험 4가 확인한다).
// 공간: 교환용 한 칸뿐. O(1). 재귀가 없다.
// 안정성: 루트와 끝을 맞바꿀 때 같은 값을 뛰어넘는다. 불안정.
